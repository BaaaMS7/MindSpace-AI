# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit file .env ke GitHub.

# ============================================================
# BACKEND EXPRESS
# ============================================================
PORT=3000
CLIENT_ORIGIN=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:3000

# Dashboard Streamlit Cloud
VITE_STREAMLIT_URL=https://mindspace-ai-analytics.streamlit.app

# Untuk menjalankan Streamlit secara lokal, ganti sementara menjadi:
VITE_STREAMLIT_URL=http://localhost:8501

# ============================================================
# CLASSIFIER FASTAPI + KERAS
# ============================================================
CLASSIFIER_API_URL=http://127.0.0.1:8002
CLASSIFIER_TIMEOUT_MS=15000

# ============================================================
# GEMINI API
# ============================================================
# Jangan expose key ini melalui prefix VITE_.
GEMINI_API_KEY=ISI_API_KEY_GEMINI_KAMU

# Flash Lite digunakan sebagai model utama agar lebih ringan.
# Flash digunakan sebagai fallback ketika layanan sedang sibuk.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

GEMINI_MAX_RETRIES_PER_MODEL=2
GEMINI_RETRY_BASE_MS=900

AI_ADVICE_TIMEOUT_MS=18000
CHAT_AI_TIMEOUT_MS=22000

# ============================================================
# MONGODB ATLAS
# ============================================================
# Masukkan URI MongoDB Atlas milikmu.
# URI non-SRV tetap boleh digunakan apabila DNS lokal bermasalah.
MONGODB_URI=ISI_URI_MONGODB_ATLAS_KAMU
MONGODB_DB_NAME=mindspace_ai

# ============================================================
# STREAMLIT ADMIN
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_ini

# ============================================================
# FIREBASE WEB AUTH
# ============================================================
# Ambil dari:
# Firebase Console -> Project settings -> General -> Web app
#
# Prefix VITE_ hanya boleh digunakan untuk konfigurasi frontend
# yang memang dapat terlihat oleh browser.
VITE_FIREBASE_API_KEY=ISI_API_KEY_FIREBASE_WEB
VITE_FIREBASE_AUTH_DOMAIN=PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=ISI_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=ISI_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=ISI_MEASUREMENT_ID_JIKA_ADA